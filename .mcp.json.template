{
  "mcpServers": {
    "ae2claude": {
      "command": "uv",
      "args": [
        "--directory",
        "<ABSOLUTE_PATH_TO_AE2CLAUDE>",
        "run",
        "--no-sync",
        "ae2claude-mcp"
      ],
      "env": {
        "AE2CLAUDE_PORT": "18889",
        "AE2CLAUDE_APPROVAL_MODE": "auto"
      }
    }
  }
}
